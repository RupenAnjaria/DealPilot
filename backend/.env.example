# Azure OpenAI is optional. Leave everything unset to run DealPilot fully deterministically
# (DEMO MODE — no external AI API required).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Alternative to Azure: any OpenAI-compatible endpoint (OpenAI itself, Azure AI Foundry
# Local, a local vLLM/Ollama server, etc.). Only used if the Azure settings above are unset.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Per-request timeout (seconds) for any AI call.
AI_TIMEOUT_SECONDS=5
