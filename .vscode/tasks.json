{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "python",
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "windows": {
        "command": ".venv\\Scripts\\python.exe"
      },
      "osx": {
        "command": ".venv/bin/python"
      },
      "linux": {
        "command": ".venv/bin/python"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dealpilot"
      }
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "windows": {
        "command": "npm.cmd"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dealpilot"
      }
    },
    {
      "label": "Start Full Stack (DealPilot)",
      "dependsOn": ["Start Backend", "Start Frontend"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Backend Tests",
      "type": "shell",
      "command": "python",
      "args": ["-m", "pytest"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "windows": {
        "command": ".venv\\Scripts\\python.exe"
      },
      "osx": {
        "command": ".venv/bin/python"
      },
      "linux": {
        "command": ".venv/bin/python"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run Frontend Build & Lint",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "windows": {
        "command": "npm.cmd"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
